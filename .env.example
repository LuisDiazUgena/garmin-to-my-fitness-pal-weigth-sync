# Garmin Connect Personal API key: https://connect.garmin.com/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=
# MyFitnessPal session: the "Cookie" header of a request to www.myfitnesspal.com from a
# logged-in browser (developer tools → Network), or just the __Secure-next-auth.session-token value
MFP_SESSION_COOKIE=

# Optional: email when a sync fails. With Gmail, SMTP_PASSWORD is an app password
# (https://myaccount.google.com/apppasswords). Other providers: also set SMTP_HOST and SMTP_PORT (SSL).
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFY_TO=
