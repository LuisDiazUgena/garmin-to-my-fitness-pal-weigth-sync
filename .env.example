# Garmin Connect Personal API key: https://connect.garmin.com/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=
# MyFitnessPal session: the "Cookie" header of a request to www.myfitnesspal.com from a
# logged-in browser (developer tools → Network), or just the __Secure-next-auth.session-token value
MFP_SESSION_COOKIE=

# Optional: read the two values above from another tool's .env instead
# SHARED_ENV_FILE=~/other-tool/.env
# Optional: where the renewed MyFitnessPal session and the Garmin token are kept (default: this
# folder). Point them to another tool's files to share one session with it.
# MFP_SESSION_FILE=~/other-tool/.mfp-session.json
# GARMIN_TOKEN_FILE=~/other-tool/.garmin-token.json
